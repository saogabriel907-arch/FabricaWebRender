@model IReadOnlyList<FabricaWebPortal.Controllers.MateriaPrimaViewModel>

@{
    ViewData["Title"] = "Matérias-Primas em Estoque";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <div>
            <h2>🧪 Matérias-Primas em Estoque</h2>
            <p class="text-muted mb-0">Somente insumos com saldo atual maior que zero.</p>
        </div>
        <span class="badge text-bg-success fs-6">@Model.Count item(ns) disponível(is)</span>
    </div>

    <div class="table-responsive mt-4">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Insumo</th>
                    <th>Tipo</th>
                    <th class="text-end">Estoque</th>
                    <th>Unidade</th>
                    <th>Fornecedor</th>
                    <th>Lote</th>
                    <th>Fabricação</th>
                    <th>Validade</th>
                    <th>Nota fiscal</th>
                    <th>Atualizado em</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.Nome</strong></td>
                            <td><span class="badge text-bg-info">@item.Tipo</span></td>
                            <td class="text-end fw-bold text-success">@item.Quantidade.ToString("N2")</td>
                            <td>@item.UnidadeMedida</td>
                            <td>@item.Fornecedor</td>
                            <td>@item.Lote</td>
                            <td>@item.DataFabricacao</td>
                            <td>@item.DataValidade</td>
                            <td>@item.NotaFiscal</td>
                            <td>
                                @(item.AtualizadoEm?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center py-4">
                            Nenhuma matéria-prima elegível com estoque disponível e dados sincronizados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
