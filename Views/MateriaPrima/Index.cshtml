@model IEnumerable<FabricaWebPortal.Controllers.HistoricoLeiteSoroViewModel>

@{
    ViewData["Title"] = "Consulta de Leite e Matéria-Prima";
}

<div class="container mt-4">
    <h2>🥛 Consulta de Leite e Soro (Entradas)</h2>
    <p class="text-muted">Histórico detalhado sincronizado da fábrica para o Supabase.</p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Insumo</th>
                    <th>Peso (KG)</th>
                    <th>Data/Hora</th>
                    <th>Fornecedor</th>
                    <th>Lote</th>
                    <th>NF</th>
                    <th>SIF</th>
                    <th>Detalhes</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.Insumo</strong></td>
                            <td>@item.Peso.ToString("N2")</td>
                            <td>@(item.DataHora == DateTime.MinValue ? "-" : item.DataHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td>
                            <td>@item.Fornecedor</td>
                            <td>@item.Lote</td>
                            <td>@item.NotaFiscal</td>
                            <td>@item.Sif</td>
                            <td>@item.OutrosDetalhes</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">Nenhum registo encontrado.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>