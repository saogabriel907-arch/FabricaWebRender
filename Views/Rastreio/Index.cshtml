@model fabricawebrender.Models.RastreabilidadeOrdemPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Rastreabilidade de Produção";
    var cultura = CultureInfo.GetCultureInfo("pt-BR");
}

<style>
    .op-summary { cursor: pointer; list-style: none; }
    .op-summary::-webkit-details-marker { display: none; }
    .op-summary:focus-visible { outline: 3px solid #86b7fe; outline-offset: 2px; }
</style>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <span class="badge rounded-pill text-bg-primary mb-2">PAINEL GERENCIAL</span>
            <h1 class="h2 mb-1">Rastreabilidade de Produção</h1>
            <p class="text-secondary mb-0">Acompanhe cada OP e os consumos reais de matéria-prima, bobinas e fardos.</p>
        </div>
        <span class="badge rounded-pill text-bg-light border text-secondary fs-6">
            @Model.TotalOrdensAbertas.ToString("N0", cultura) OP(s) em aberto
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErroFiltro))
    {
        <div class="alert alert-warning" role="alert">@Model.ErroFiltro</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="small text-secondary">OPs em aberto</div>
                    <div class="fs-3 fw-bold text-warning">@Model.TotalOrdensAbertas.ToString("N0", cultura)</div>
                    <div class="small text-secondary">Aguardando conclusão</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="small text-secondary">OPs finalizadas</div>
                    <div class="fs-3 fw-bold text-success">@Model.TotalOrdensFinalizadas.ToString("N0", cultura)</div>
                    <div class="small text-secondary">Histórico de produção</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="small text-secondary">@(Model.MostrarSemOrdem ? "Movimentos encontrados" : "OPs encontradas")</div>
                    <div class="fs-3 fw-bold">
                        @(Model.MostrarSemOrdem
                            ? Model.TotalMovimentosSemOrdemFiltrados.ToString("N0", cultura)
                            : Model.TotalOrdensFiltradas.ToString("N0", cultura))
                    </div>
                    <div class="small text-secondary">Com os filtros atuais</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <a class="card h-100 border-0 shadow-sm text-decoration-none text-reset"
               asp-controller="Rastreio" asp-action="Index" asp-route-mostrarSemOrdem="true">
                <div class="card-body">
                    <div class="small text-secondary">Movimentos fora de OP</div>
                    <div class="fs-3 fw-bold text-primary">@Model.TotalMovimentosSemOrdem.ToString("N0", cultura)</div>
                    <div class="small text-primary">Ver movimentos de matéria-prima sem OP →</div>
                </div>
            </a>
        </div>
    </div>

    <form method="get" asp-controller="Rastreio" asp-action="Index" class="card border-0 shadow-sm mb-4">
        @if (Model.MostrarSemOrdem)
        {
            <input type="hidden" name="mostrarSemOrdem" value="true" />
        }
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-5">
                    <label for="pesquisa" class="form-label fw-semibold">
                        @(Model.MostrarSemOrdem ? "Buscar insumo ou movimento" : "Buscar OP, lote, produto ou insumo")
                    </label>
                    <input id="pesquisa" name="pesquisa" value="@Model.Pesquisa" class="form-control"
                           placeholder="@(Model.MostrarSemOrdem ? "Nome do insumo ou número do movimento" : "Também pesquisa o lote da bobina e o número do movimento")" maxlength="100" />
                </div>
                <div class="col-6 col-lg-2">
                    <label for="dataInicial" class="form-label fw-semibold">@(Model.MostrarSemOrdem ? "Data de" : "Criada de")</label>
                    <input id="dataInicial" name="dataInicial" type="date" value="@Model.DataInicial" class="form-control" />
                </div>
                <div class="col-6 col-lg-2">
                    <label for="dataFinal" class="form-label fw-semibold">@(Model.MostrarSemOrdem ? "Data até" : "Criada até")</label>
                    <input id="dataFinal" name="dataFinal" type="date" value="@Model.DataFinal" class="form-control" />
                </div>
                @if (!Model.MostrarSemOrdem)
                {
                    <div class="col-12 col-lg-2">
                        <label for="status" class="form-label fw-semibold">Situação da OP</label>
                        <select id="status" name="status" class="form-select">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.Status) ? "selected" : null)">Todas</option>
                            <option value="aberta" selected="@(Model.Status == "aberta" ? "selected" : null)">Em aberto</option>
                            <option value="finalizada" selected="@(Model.Status == "finalizada" ? "selected" : null)">Finalizada</option>
                        </select>
                    </div>
                }
                <div class="col-12 col-lg-@(Model.MostrarSemOrdem ? "3" : "1") d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Filtrar</button>
                    @if (Model.MostrarSemOrdem)
                    {
                        <a asp-controller="Rastreio" asp-action="Index" asp-route-mostrarSemOrdem="true"
                           class="btn btn-outline-secondary">Limpar</a>
                    }
                    else
                    {
                        <a asp-controller="Rastreio" asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
                    }
                </div>
            </div>
        </div>
    </form>

    @if (Model.MostrarSemOrdem)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h2 class="h4 mb-1">Movimentos sem OP associada</h2>
                <p class="text-secondary mb-0">Registros de matéria-prima sem vínculo com uma ordem de produção.</p>
            </div>
            <a asp-controller="Rastreio" asp-action="Index" class="btn btn-outline-primary">Voltar às OPs</a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Data / hora</th>
                            <th>Insumo</th>
                            <th>Categoria</th>
                            <th class="text-end">Quantidade</th>
                            <th>Movimento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MovimentosSemOrdem.Count > 0)
                        {
                            @foreach (var movimento in Model.MovimentosSemOrdem)
                            {
                                <tr>
                                    <td class="text-nowrap">
                                        <strong>@movimento.DataMovimentacao.ToString("dd/MM/yyyy")</strong>
                                        <small class="d-block text-secondary">@movimento.DataMovimentacao.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <strong class="d-block">@(string.IsNullOrWhiteSpace(movimento.Insumo) ? "Insumo não identificado" : movimento.Insumo)</strong>
                                        <small class="text-secondary">ID @movimento.IdInsumo</small>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(movimento.Categoria) ? "Não informada" : movimento.Categoria)</td>
                                    <td class="text-end text-nowrap fw-semibold">
                                        @movimento.QuantidadeConsumida.ToString("N2", cultura)
                                        <small class="text-secondary">@(string.IsNullOrWhiteSpace(movimento.UnidadeMedida) ? "" : movimento.UnidadeMedida)</small>
                                    </td>
                                    <td>@movimento.IdMovimentacao</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-secondary py-5">
                                    Nenhum movimento sem OP encontrado com esses filtros.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    }
    else
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h2 class="h4 mb-1">Ordens de produção</h2>
                <p class="text-secondary mb-0">
                    @Model.TotalOrdensFiltradas.ToString("N0", cultura) OP(s) encontradas · mais recentes primeiro
                </p>
            </div>
            @if (Model.TotalPaginas > 0)
            {
                <span class="badge text-bg-light border text-secondary">Página @Model.PaginaAtual de @Model.TotalPaginas</span>
            }
        </div>

        @if (Model.Ordens.Count > 0)
        {
            @foreach (var ordem in Model.Ordens)
            {
                var totalPlanejado = ordem.Produtos.Sum(produto => produto.QuantidadeFardos);
                var statusAberto = string.Equals(ordem.Status, "Em Aberto", StringComparison.OrdinalIgnoreCase);
                <details class="card border-0 shadow-sm mb-3">
                    <summary class="op-summary card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <span class="badge text-bg-dark">OP @ordem.IdOrdem</span>
                                <strong class="fs-5">@(string.IsNullOrWhiteSpace(ordem.Lote) ? "Lote não informado" : ordem.Lote)</strong>
                                @if (statusAberto)
                                {
                                    <span class="badge rounded-pill text-bg-warning">Em aberto</span>
                                }
                                else if (string.Equals(ordem.Status, "Finalizada", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge rounded-pill text-bg-success">Finalizada</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">@(string.IsNullOrWhiteSpace(ordem.Status) ? "Situação não informada" : ordem.Status)</span>
                                }
                            </div>
                            <small class="text-secondary">
                                Aberta em @(ordem.DataCriacao?.ToString("dd/MM/yyyy HH:mm") ?? "Data não informada")
                                · @ordem.Produtos.Count produto(s) planejado(s)
                                · @ordem.Movimentos.Count movimento(s)
                            </small>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @if (ordem.QuantidadeMovimentosMateriaPrima > 0)
                            {
                                <span class="badge text-bg-info">
                                    Matéria-prima: @ordem.TotalMateriaPrima.ToString("N2", cultura) KG
                                </span>
                            }
                            @if (ordem.QuantidadeMovimentosBobina > 0)
                            {
                                <span class="badge text-bg-primary">
                                    Bobina: @ordem.TotalBobinas.ToString("N2", cultura) KG
                                </span>
                            }
                            @if (ordem.QuantidadeMovimentosFardo > 0)
                            {
                                <span class="badge text-bg-warning">
                                    Fardo: @ordem.TotalFardos.ToString("N0", cultura) UN
                                </span>
                            }
                            @if (ordem.Movimentos.Count == 0)
                            {
                                <span class="badge text-bg-light border text-secondary">Sem baixas registradas</span>
                            }
                        </div>
                    </summary>

                    <div class="card-body">
                        <div class="row g-4 mb-4">
                            <div class="col-12 col-lg-5">
                                <h3 class="h6 fw-bold">Produto(s) planejado(s)</h3>
                                @if (ordem.Produtos.Count > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Produto</th>
                                                    <th class="text-end">Fardos previstos</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var produto in ordem.Produtos)
                                                {
                                                    <tr>
                                                        <td>@produto.Nome</td>
                                                        <td class="text-end text-nowrap">@produto.QuantidadeFardos.ToString("N0", cultura)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot>
                                                <tr class="fw-bold">
                                                    <td>Total planejado</td>
                                                    <td class="text-end">@totalPlanejado.ToString("N0", cultura)</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-secondary mb-0">Nenhum produto final vinculado a esta OP.</p>
                                }
                            </div>
                            <div class="col-12 col-lg-7">
                                <h3 class="h6 fw-bold">Consumo registrado nesta OP</h3>
                                <div class="row g-2">
                                    <div class="col-12 col-md-4">
                                        <div class="rounded border bg-light p-3 h-100">
                                            <div class="small text-secondary">Matéria-prima</div>
                                            <div class="fw-bold">@ordem.TotalMateriaPrima.ToString("N2", cultura) KG</div>
                                            <small class="text-secondary">@ordem.QuantidadeMovimentosMateriaPrima movimento(s)</small>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="rounded border bg-light p-3 h-100">
                                            <div class="small text-secondary">Bobinas</div>
                                            <div class="fw-bold">@ordem.TotalBobinas.ToString("N2", cultura) KG</div>
                                            <small class="text-secondary">
                                                @ordem.QuantidadeMovimentosBobina movimento(s) · @ordem.LotesBobinaRegistrados lote(s) identificado(s)
                                            </small>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <div class="rounded border bg-light p-3 h-100">
                                            <div class="small text-secondary">Fardos</div>
                                            <div class="fw-bold">@ordem.TotalFardos.ToString("N0", cultura) UN</div>
                                            <small class="text-secondary">@ordem.QuantidadeMovimentosFardo movimento(s) · lote não se aplica</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h3 class="h6 fw-bold">Detalhamento dos movimentos</h3>
                        @if (ordem.Movimentos.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Data / hora</th>
                                            <th>Categoria</th>
                                            <th>Insumo</th>
                                            <th class="text-end">Quantidade</th>
                                            <th>Lote da bobina</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var movimento in ordem.Movimentos)
                                        {
                                            var movimentoBobina = movimento.Categoria?.Contains("bobina", StringComparison.OrdinalIgnoreCase) == true
                                                || movimento.Insumo?.StartsWith("Film", StringComparison.OrdinalIgnoreCase) == true;
                                            <tr>
                                                <td class="text-nowrap">@movimento.DataMovimentacao.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@(string.IsNullOrWhiteSpace(movimento.Categoria) ? "Não informada" : movimento.Categoria)</td>
                                                <td>
                                                    <span class="fw-semibold">@movimento.Insumo</span>
                                                    <small class="d-block text-secondary">Movimento @movimento.IdMovimentacao</small>
                                                </td>
                                                <td class="text-end text-nowrap">
                                                    @movimento.QuantidadeConsumida.ToString("N2", cultura)
                                                    @(string.IsNullOrWhiteSpace(movimento.UnidadeMedida) ? "" : movimento.UnidadeMedida)
                                                </td>
                                                <td>
                                                    @if (movimentoBobina)
                                                    {
                                                        @(string.IsNullOrWhiteSpace(movimento.LoteBobina) ? "Não informado" : movimento.LoteBobina)
                                                    }
                                                    else
                                                    {
                                                        <span class="text-secondary">—</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-light border mb-0">
                                Esta OP ainda não possui baixas de matéria-prima, bobina ou fardo registradas.
                            </div>
                        }
                    </div>
                </details>
            }
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <h3 class="h5">Nenhuma OP encontrada</h3>
                    <p class="text-secondary mb-0">Altere os filtros ou limpe a pesquisa para ver outras ordens.</p>
                </div>
            </div>
        }
    }

    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginação da rastreabilidade" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PaginaAtual <= 1 ? "disabled" : "")">
                    @if (Model.PaginaAtual <= 1)
                    {
                        <span class="page-link">Anterior</span>
                    }
                    else
                    {
                        <a class="page-link" asp-controller="Rastreio" asp-action="Index"
                           asp-route-page="@(Model.PaginaAtual - 1)" asp-route-pesquisa="@Model.Pesquisa"
                           asp-route-dataInicial="@Model.DataInicial" asp-route-dataFinal="@Model.DataFinal"
                           asp-route-status="@Model.Status" asp-route-mostrarSemOrdem="@Model.MostrarSemOrdem">Anterior</a>
                    }
                </li>
                <li class="page-item disabled"><span class="page-link">Página @Model.PaginaAtual de @Model.TotalPaginas</span></li>
                <li class="page-item @(Model.PaginaAtual >= Model.TotalPaginas ? "disabled" : "")">
                    @if (Model.PaginaAtual >= Model.TotalPaginas)
                    {
                        <span class="page-link">Próxima</span>
                    }
                    else
                    {
                        <a class="page-link" asp-controller="Rastreio" asp-action="Index"
                           asp-route-page="@(Model.PaginaAtual + 1)" asp-route-pesquisa="@Model.Pesquisa"
                           asp-route-dataInicial="@Model.DataInicial" asp-route-dataFinal="@Model.DataFinal"
                           asp-route-status="@Model.Status" asp-route-mostrarSemOrdem="@Model.MostrarSemOrdem">Próxima</a>
                    }
                </li>
            </ul>
        </nav>
    }
</div>
