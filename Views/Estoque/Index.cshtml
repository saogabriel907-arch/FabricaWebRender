@model FabricaWebRender.Models.EstoquePageViewModel

@{
    ViewData["Title"] = "Bobinas e Fardos - Fábrica";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold text-dark">📦 Bobinas e Fardos disponíveis</h2>
            <p class="text-muted">Consulte o estoque de embalagens sincronizado com a fábrica.</p>
        </div>
    </div>

    <form asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
        <div class="col-sm-6 col-md-4">
            <label for="categoria" class="form-label fw-semibold">Tipo de insumo</label>
            <select id="categoria" name="categoria" class="form-select">
                <option value="todas" selected="@(Model.CategoriaSelecionada == "todas" ? "selected" : null)">Bobinas e fardos</option>
                <option value="bobina" selected="@(Model.CategoriaSelecionada == "bobina" ? "selected" : null)">Bobinas</option>
                <option value="fardo" selected="@(Model.CategoriaSelecionada == "fardo" ? "selected" : null)">Fardos</option>
            </select>
        </div>
        <div class="col-sm-6 col-md-4">
            <label for="ordenacao" class="form-label fw-semibold">Ordenar quantidade</label>
            <select id="ordenacao" name="ordenacao" class="form-select">
                <option value="quantidade_desc" selected="@(Model.OrdenacaoSelecionada == "quantidade_desc" ? "selected" : null)">Maior para menor</option>
                <option value="quantidade_asc" selected="@(Model.OrdenacaoSelecionada == "quantidade_asc" ? "selected" : null)">Menor para maior</option>
            </select>
        </div>
        <div class="col-sm-12 col-md-auto">
            <button type="submit" class="btn btn-primary">Aplicar filtros</button>
        </div>
        <div class="col-12">
            <span class="text-muted">@Model.Registros.Count insumo(s) encontrado(s)</span>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Insumo</th>
                            <th>Tipo</th>
                            <th>Marca</th>
                            <th>Lote</th>
                            <th>Quantidade</th>
                            <th>Unidade</th>
                            <th>Última Atualização</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Registros.Count > 0)
                        {
                            @foreach (var item in Model.Registros)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.nome</td>
                                    <td>@item.categoria</td>
                                    <td>@(string.IsNullOrEmpty(item.marca) ? "-" : item.marca)</td>
                                    <td><code>@(string.IsNullOrEmpty(item.lote_fabricante) ? "-" : item.lote_fabricante)</code></td>
                                    <td>
                                        @if (item.quantidade <= 10)
                                        {
                                            <span class="badge bg-danger">@item.quantidade (Baixo)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@item.quantidade</span>
                                        }
                                    </td>
                                    <td>@item.unidade_medida</td>
                                    <td><small class="text-muted">@(item.atualizado_em?.ToString("dd/MM/yyyy HH:mm") ?? "-")</small></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Nenhuma bobina ou fardo encontrado para os filtros selecionados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>