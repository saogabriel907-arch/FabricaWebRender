@using System.Globalization
@model FabricaWebRender.Models.SimuladorProducaoViewModel

@{
    ViewData["Title"] = "Simulador de Produção";
    var cultura = CultureInfo.GetCultureInfo("pt-BR");
    var geradoEm = DateTime.Now.ToString("dd/MM/yyyy HH:mm", cultura);
}

<style>
    @@media print {
        @@page {
            size: A4 landscape;
            margin: 10mm;
        }

        html, body {
            background: #fff !important;
            color: #172033 !important;
            font-size: 9pt;
            print-color-adjust: exact;
            -webkit-print-color-adjust: exact;
        }

        header, footer, .no-print {
            display: none !important;
        }

        .container {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .card {
            break-inside: avoid;
            box-shadow: none !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        table {
            width: 100% !important;
            font-size: 8pt;
        }

        thead {
            display: table-header-group;
        }

        tr {
            break-inside: avoid;
        }

        th, td {
            padding: 4px 6px !important;
        }

        .print-meta {
            display: block !important;
        }
    }

    .print-meta {
        display: none;
    }
</style>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-2">Simulador de Produção por Bobina</h1>
            <p class="text-muted mb-0">Estimativa de fardos e de leite que podem ser produzidos com o estoque atual de bobinas.</p>
        </div>
        <div class="no-print d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" asp-controller="Estoque" asp-action="Index">Ver estoque completo</a>
            <button type="button" class="btn btn-success fw-semibold" title="Na janela de impressão, escolha Salvar como PDF." onclick="window.print()">
                <span aria-hidden="true">📄</span> Gerar PDF
            </button>
        </div>
    </div>

    <div class="print-meta mb-3">
        <div class="fw-bold">FabricaWeb — Relatório estimado de produção</div>
        <div>Estoque consultado em @geradoEm</div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="small text-muted">Estoque total de bobinas</div>
                    <div class="fs-3 fw-bold">@Model.EstoqueTotalKg.ToString("N2", cultura) kg</div>
                    <div class="small text-muted">@Model.Bobinas.Count bobina(s) considerada(s)</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="small text-muted">Fardos estimados</div>
                    <div class="fs-3 fw-bold">@Model.TotalFardosEstimados.ToString("N2", cultura)</div>
                    <div class="small text-muted">Estimativa proporcional pela regra de consumo</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="small text-muted">Leite estimado</div>
                    <div class="fs-3 fw-bold">@Model.TotalLeiteEstimadoKg.ToString("N2", cultura) kg</div>
                    <div class="small text-muted">10 kg por fardo; 800 g: 9,6 kg; Vita Leite 350 g: 10,5 kg</div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info">
        <strong>Consumo total de bobina por fardo:</strong> 200 g = 260 g; 400 g = 175 g;
        Vita Leite 350 g = 174 g; 800 g = 129,6 g; 1 kg = 120 g.
        O fardo de 800 g corresponde a 9,6 kg de leite e o Vita Leite 350 g a 10,5 kg.
        Valores te&oacute;ricos, sem descontar perdas de produ&ccedil;&atilde;o.
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white">
            <h2 class="h5 mb-0">Rendimento estimado por bobina</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tipo de bobina</th>
                        <th>Gramatura / regra</th>
                        <th class="text-end">Consumo por fardo</th>
                        <th class="text-end">Estoque atual</th>
                        <th class="text-end">Fardos estimados</th>
                        <th class="text-end">Leite por fardo</th>
                        <th class="text-end">Leite estimado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Bobinas.Count > 0)
                    {
                        @foreach (var bobina in Model.Bobinas)
                        {
                            <tr>
                                <td class="fw-semibold">@bobina.Nome</td>
                                <td>@bobina.GramaturaIdentificada</td>
                                <td class="text-end">@bobina.ConsumoBobinaKgPorFardo.ToString("N4", cultura) kg</td>
                                <td class="text-end">@bobina.EstoqueAtualKg.ToString("N2", cultura) kg</td>
                                <td class="text-end fw-bold">@bobina.FardosEstimados.ToString("N2", cultura)</td>
                                <td class="text-end">@bobina.LeiteKgPorFardo.ToString("N2", cultura) kg</td>
                                <td class="text-end fw-bold text-success">@bobina.LeiteEstimadoKg.ToString("N2", cultura) kg</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Nenhuma bobina foi encontrada no estoque sincronizado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
